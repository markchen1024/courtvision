# Copy to .env and fill in. .env is gitignored; this file is not, so never put a
# real key here.
#
# Roboflow, for pulling the public basketball court keypoint model. The key only
# downloads weights -- inference then runs locally, so no footage leaves the
# machine. Get one from the workspace settings, under API Keys.
ROBOFLOW_API_KEY=
HF_TOKEN=
