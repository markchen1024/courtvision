# Python
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# Node
node_modules/
dist/
.next/

# Env
.env
.env.*
!.env.example

# Model weights & footage — never commit these
*.pt
*.onnx
*.mp4
*.mov
*.mkv
/data/
footage/
out/
output/
runs/

# Junctions into web/ — the sources of truth are web/media and web/data;
# tracking the junction side would commit everything twice.
webapp/public/media/
webapp/public/data/

# Crop strips that label_truth.py renders for reading jersey numbers off a
# track. 8MB of JPEG, regenerable from the tracks file in a minute, and only
# useful while someone is filling in a truth file. The truth files themselves
# are hand-made and stay in the repo.
eval/tracks/
eval/sheets/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Demo footage lives here. Only the five shipped homepage files travel with
# the repo — two machine handoffs in a row failed on the manual copy, so the
# shipped set rides git now (each file is under GitHub's 100MB hard limit;
# the repo is private and short-lived, so the history cost is accepted).
# Raw footage, reference downloads and everything else stay out. The
# directory rule must be `/*`, not `/`: an ignored *directory* cannot have
# files negated back in, an ignored *glob* can.
web/media/*
!web/media/nba_ai.mp4
!web/media/nba.mp4
!web/media/reel.mp4
!web/media/poster.jpg
!web/media/reel_poster.jpg
